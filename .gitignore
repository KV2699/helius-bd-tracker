node_modules/
.env
.env.*
data/runs/*.json
!data/runs/.gitkeep
.DS_Store

# Artefacts produced by runs. The code and the docs are the submission; the
# run outputs are reproducible by anyone with a NEAR AI key.
data/discovered/*.json
data/bridge/*.json
data/history.json
data/*.xlsx
.claude/

# ...but a judge must be able to see real results without a NEAR AI key, so one
# committed snapshot of real run output is tracked on purpose. The server falls
# back to it when data/runs is empty. See README "Judge quick start".
!data/snapshot/
!data/snapshot/*.json
